{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: Linux (GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/out/build/linux-debug/tiktok_backend",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "MIMode": "gdb",
      "preLaunchTask": "C++: build",
      "externalConsole": false
    },
    {
      "name": "Backend: Windows (MSVC)",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\out\\build\\windows-debug\\Debug\\tiktok_backend.exe",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "C++: build",
      "externalConsole": false
    },
    {
      "name": "Frontend: Chrome",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/src"
    }
  ]
}
