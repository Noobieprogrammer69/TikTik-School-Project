# Copy this file to .env. Never commit the real .env file.

# Required by Docker Compose. Use a long random value; do not reuse a school/email password.
MONGO_ROOT_USERNAME=tiktokadmin
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password
# Localhost port used only when native tools/tests connect to the Compose MongoDB.
MONGO_PORT=27017

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Web Client.
# Add http://localhost:3000 to Authorized JavaScript origins. There is no client secret for this flow.
GOOGLE_CLIENT_ID=replace-with-your-web-client-id.apps.googleusercontent.com

# Browser port exposed by Docker. Google and FRONTEND_ORIGIN must use this same port.
FRONTEND_PORT=3000
# Optional loopback-only port for direct API tests and native debugging.
BACKEND_HOST_PORT=8080

# 2 GiB, matching the original upload screen. Lower this on machines with limited memory.
MAX_UPLOAD_BYTES=2147483648

# Seven days in seconds.
SESSION_TTL_SECONDS=604800
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=300

# false for local http://localhost. Set true only when the browser uses HTTPS.
COOKIE_SECURE=false

# Test-only login is disabled by default. Never enable it on a public deployment.
ENABLE_TEST_AUTH=false
TEST_AUTH_KEY=replace-with-at-least-24-random-characters

# Comma-separated Google user IDs allowed to open the moderation dashboard.
# Find your stable ID in the profile URL after logging in, for example: 114625090757986249517
ADMIN_USER_IDS=

# Docker includes FFmpeg. Native builds need FFmpeg on PATH or an absolute executable path here.
ENABLE_MEDIA_PROCESSING=true
FFMPEG_BINARY=ffmpeg

# Native backend defaults; Docker Compose overrides these internally.
# If using the Compose MongoDB from a native backend, include the same username/password:
# MONGODB_URI=mongodb://tiktokadmin:YOUR_PASSWORD@127.0.0.1:27017/tiktok_clone?authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017/tiktok_clone
MONGODB_DATABASE=tiktok_clone
MEDIA_ROOT=./data/media
BACKEND_LISTEN_ADDRESS=0.0.0.0
BACKEND_PORT=8080
FRONTEND_ORIGIN=http://localhost:3000
